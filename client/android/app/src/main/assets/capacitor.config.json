{
	"appId": "com.snapit.grocery",
	"appName": "Snapit",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"hostname": "snapit.grocery",
		"cleartext": true,
		"allowNavigation": [
			"snapit-full-stack-2.onrender.com"
		]
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"hardwareAccelerated": true,
		"backgroundColor": "#ffffff",
		"initialFocus": true
	},
	"plugins": {
		"CapacitorCookies": {
			"enabled": true
		},
		"CapacitorHttp": {
			"enabled": true
		}
	}
}
