{
  "name": "Snapit - 10 Min Grocery Delivery",
  "short_name": "Snapit",
  "description": "Order groceries and get delivery in 10 minutes from Snapit",
  "id": "com.snapit.app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
