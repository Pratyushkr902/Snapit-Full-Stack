{
  "appId": "com.snapit.grocery",
  "appName": "Snapit",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "snapit.grocery",
    "cleartext": true,
    "allowNavigation": [
      "snapit-full-stack-2.onrender.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "hardwareAccelerated": true,
    "backgroundColor": "#FFFFFF",
    "initialFocus": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#FFFFFF",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}